# Lean parity data exports — the H4 candle CSVs are bulky market data,
# regenerable via scripts/export_lean_parity_data.py. The small manifests
# and provenance JSONs ARE committed.
research/lean_parity/exports/**/*.csv

# Per-run backtest artifacts are huge (700MB+ per campaign) and
# fully reproducible via scripts/run_campaign_00X.py. Commit only the
# top-level reports, audit summaries, indexes, and summary JSONs.
backtests/campaign_001/runs/**/*_equity.csv
backtests/campaign_001/runs/**/*_trades.csv
backtests/campaign_001/runs/**/*_metrics.json
backtests/campaign_001/runs/**/*_metrics.md
backtests/campaign_001/runs.pre_pnl_fix/
backtests/campaign_001/_*.log
backtests/CAMPAIGN_001_REPORT.pre_pnl_fix.md
backtests/campaign_002_real_oanda/runs/**/*_equity.csv
backtests/campaign_002_real_oanda/runs/**/*_trades.csv
backtests/campaign_002_real_oanda/runs/**/*_metrics.json
backtests/campaign_002_real_oanda/runs/**/*_metrics.md
backtests/campaign_002_real_oanda/_*.log
