backtests/campaign_003_controlled_adx/runs/**/*_trades.csv
backtests/campaign_003_controlled_adx/runs/**/*_metrics.json
backtests/campaign_003_controlled_adx/runs/**/*_metrics.md
backtests/campaign_003_controlled_adx/_*.log
